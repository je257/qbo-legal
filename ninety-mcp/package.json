{
  "name": "ninety-mcp",
  "version": "0.3.0",
  "description": "MCP server connecting Claude to Ninety.io (To-Dos, Rocks, Milestones, Issues, Scorecard, Teams, Users): desktop (stdio) and hosted (Cloudflare Worker) builds",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "bin": {
    "ninety-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "start": "node dist/index.js",
    "check:cloud": "tsc -p cloud/tsconfig.json",
    "test": "npm run build && npm run check:cloud && node --test test/desktop-regression.test.mjs test/cloud.test.mjs",
    "cloud:smoke": "node scripts/smoke-cloud.mjs",
    "deploy": "npm test && wrangler deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@cloudflare/workers-types": "^5.20261112.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "wrangler": "^4.160.1"
  }
}
